# LLM provider
ANTHROPIC_API_KEY=replace_with_your_key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_BASE_URL=https://your-compatible-endpoint.example.com

# API
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Storage
REDIS_PASSWORD=change_me_before_deploying
REDIS_URL=redis://:change_me_before_deploying@redis:6379/0
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=/app/data/chroma

# Observability and evaluation
PROMETHEUS_PORT=0
MONITOR_INTERVAL=10
ALERT_WEBHOOK_URL=
EVAL_BASELINE_PATH=/app/data/eval/baseline.json
EVAL_REPORT_DIR=/app/data/eval/reports

# NovaRelay runtime tuning
NOVARELAY_SKILLS_DIR=/app/skills
NOVARELAY_SKILLS_MAX_PROMPT_CHARS=5000
NOVARELAY_TOOL_TRACE_MAX=200
